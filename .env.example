# ---------------------------------------------------------------------------
# Phase 0 environment template — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_DAILY_REPORT_CHANNEL_ID=
DISCORD_OWNER_USER_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# --- Twilio (P0 SMS only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Email (daily report) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Anthropic API (separate from Max — for ops review only) ---
ANTHROPIC_API_KEY=

# --- Daily check-in cron ---
DAILY_REPORT_HOUR_LOCAL=7
DAILY_REPORT_TIMEZONE=America/New_York

# --- Capital tracking (informs VPN-trigger threshold) ---
DEPLOYED_CAPITAL_USD=0
VPN_TRIGGER_THRESHOLD_USD=50000

# --- Cloudflare Tunnel (filled at provisioning time) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Bot framework ---
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_ALERT_AFTER_SECONDS=120
HEARTBEAT_RESTART_AFTER_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_DRIFT_THRESHOLD_PCT=0.5
CONSECUTIVE_LOSS_HALT_COUNT=8
CONSECUTIVE_LOSS_HALT_HOURS=24

# --- Fleet-wide kill switches ---
FLEET_DAILY_DD_HALT_PCT=10.0
FLEET_TOTAL_DD_KILL_PCT=25.0
FLEET_AUTO_RESUME_HOURS=48
FLEET_AUTO_RESUME_BTC_STABILITY_PCT=5.0

# --- Hyperliquid (STRUCTURE bot) ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Agent private key generated on app.hyperliquid.xyz; permission must be Trade-only.
# Empty for Build A (paper-only). Populated before Build B / shakedown.
HYPERLIQUID_AGENT_PRIVATE_KEY=
# Master wallet (Rabby). Public, safe to commit elsewhere — kept in .env for symmetry.
HYPERLIQUID_MASTER_ADDRESS=

# --- STRUCTURE bot config ---
STRUCTURE_PAPER_CAPITAL_USD=1000
STRUCTURE_SHADOW_PCT=10
STRUCTURE_DD_DAILY_PCT=15.0
STRUCTURE_DD_WEEKLY_PCT=30.0
STRUCTURE_DD_TOTAL_PCT=45.0
STRUCTURE_LOOP_INTERVAL_SECONDS=5
STRUCTURE_FUNDING_POLL_SECONDS=30
STRUCTURE_WHALE_POLL_SECONDS=60

# --- Helius (Solana side of COPY bot) ---
# Sign up at https://helius.xyz Developer plan ~$50/mo
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# --- Cielo (wallet curation + EVM activity for COPY bot) ---
# Sign up at https://cielo.finance Premium ~$40/mo
CIELO_API_KEY=
CIELO_API_BASE=https://feed-api.cielo.finance/api/v1

# --- Jupiter (Solana DEX quoter) ---
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote

# --- 0x (EVM DEX quoter) ---
ZEROEX_API_BASE=https://api.0x.org

# --- COPY bot config ---
COPY_PAPER_CAPITAL_USD=1000
COPY_SHADOW_PCT=10
COPY_DD_DAILY_PCT=12.0
COPY_DD_WEEKLY_PCT=28.0
COPY_DD_TOTAL_PCT=50.0
COPY_LOOP_INTERVAL_SECONDS=5
COPY_WALLET_POLL_SECONDS=10
COPY_EVM_WALLET_POLL_SECONDS=120
COPY_CLUSTER_WINDOW_MINUTES=15
