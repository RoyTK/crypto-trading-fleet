# ---------------------------------------------------------------------------
# Phase 0 environment template — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_DAILY_REPORT_CHANNEL_ID=
DISCORD_OWNER_USER_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# --- Twilio (P0 SMS only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Email (daily report) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Anthropic API (separate from Max — for ops review only) ---
ANTHROPIC_API_KEY=

# --- Daily check-in cron ---
DAILY_REPORT_HOUR_LOCAL=7
DAILY_REPORT_TIMEZONE=America/New_York

# --- Capital tracking (informs VPN-trigger threshold) ---
DEPLOYED_CAPITAL_USD=0
VPN_TRIGGER_THRESHOLD_USD=50000

# --- Cloudflare Tunnel (filled at provisioning time) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Bot framework ---
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_ALERT_AFTER_SECONDS=120
HEARTBEAT_RESTART_AFTER_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_DRIFT_THRESHOLD_PCT=0.5
CONSECUTIVE_LOSS_HALT_COUNT=8
CONSECUTIVE_LOSS_HALT_HOURS=24

# --- Fleet-wide kill switches ---
FLEET_DAILY_DD_HALT_PCT=10.0
FLEET_TOTAL_DD_KILL_PCT=25.0
FLEET_AUTO_RESUME_HOURS=48
FLEET_AUTO_RESUME_BTC_STABILITY_PCT=5.0

# --- Hyperliquid (STRUCTURE bot) ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Agent private key generated on app.hyperliquid.xyz; permission must be Trade-only.
# Empty for Build A (paper-only). Populated before Build B / shakedown.
HYPERLIQUID_AGENT_PRIVATE_KEY=
# Master wallet (Rabby). Public, safe to commit elsewhere — kept in .env for symmetry.
HYPERLIQUID_MASTER_ADDRESS=

# --- STRUCTURE bot config ---
STRUCTURE_PAPER_CAPITAL_USD=1000
STRUCTURE_SHADOW_PCT=10
STRUCTURE_DD_DAILY_PCT=15.0
STRUCTURE_DD_WEEKLY_PCT=30.0
STRUCTURE_DD_TOTAL_PCT=45.0
STRUCTURE_LOOP_INTERVAL_SECONDS=5
STRUCTURE_FUNDING_POLL_SECONDS=30
STRUCTURE_WHALE_POLL_SECONDS=60
STRUCTURE_COINGLASS_POLL_SECONDS=30
# liquidation_cascade is gated behind this flag because Coinglass Hobbyist
# tier ($35/mo) only supports 4h+ intervals — too coarse for the 5-min
# cascade detector. Standard tier ($379/mo) supports 5min but isn't worth
# it for an unproven signal. Keep false until/unless that calculus changes.
STRUCTURE_LIQ_CASCADE_ENABLED=false
# Disable funding_fade signal (data-driven correction, signed 2026-05-29):
# statistician p=0.72 at N=198, N=47 paper WR=21% in current window,
# -$1,103 actual loss. Disabling stops the bleed while preserving
# whale_flip + hl_oi_divergence. See memory/project_decision_log.md.
STRUCTURE_FUNDING_FADE_ENABLED=true
# COPY cluster_buy pause flag — set false to stop DEX trades while keeping
# wallet pool / Helius / shadow log running. Signed 2026-05-28 per adversarial
# team meeting (WR=17.6% N=34, adverse signal confirmed). See decision log.
COPY_CLUSTER_BUY_ENABLED=true

# --- Coinglass (liquidation_cascade signal source) ---
# HL has no public liquidations feed; Coinglass aggregates across venues.
# Sign up at https://www.coinglass.com — Hobbyist tier $35/mo (30 req/min).
# Hobbyist is liquidation-data-restricted to 4h+ intervals.
COINGLASS_API_KEY=

# --- Coinalyze (free OI/funding/liquidation aggregator) ---
# 40 req/min free tier. Covers HL OI + funding rate but NOT HL liquidations.
# Held for potential future cross-validation against HL native OI feed.
COINALYZE_API_KEY=

# --- Helius (Solana side of COPY bot) ---
# Sign up at https://helius.xyz Developer plan ~$50/mo
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# --- Cielo (wallet curation + EVM activity for COPY bot) ---
# Sign up at https://cielo.finance Premium ~$40/mo
CIELO_API_KEY=
CIELO_API_BASE=https://feed-api.cielo.finance/api/v1
# Birdeye (wallet discovery for curation; free Standard tier OK)
BIRDEYE_API_KEY=
# Helius webhook auth — random 32+ char string, set on Helius webhook + receiver
HELIUS_WEBHOOK_AUTH_SECRET=
# Public URL where Helius posts webhook events (Cloudflare Tunnel route)
COPY_WEBHOOK_URL=https://webhooks.royfleet.dev/copy/helius
# Internal port for the webhook_receiver service
WEBHOOK_RECEIVER_PORT=8090

# --- Jupiter (Solana DEX quoter) ---
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote

# --- 0x (EVM DEX quoter) ---
ZEROEX_API_BASE=https://api.0x.org

# --- COPY bot config ---
COPY_PAPER_CAPITAL_USD=10000
COPY_SHADOW_PCT=10
COPY_DD_DAILY_PCT=12.0
COPY_DD_WEEKLY_PCT=28.0
COPY_DD_TOTAL_PCT=50.0
COPY_LOOP_INTERVAL_SECONDS=5
COPY_WALLET_POLL_SECONDS=10
COPY_EVM_WALLET_POLL_SECONDS=120
COPY_CLUSTER_WINDOW_MINUTES=15

# --- COPY live + shadow execution (2026-06-06 executor skeleton) ---
# Master gate. Default FALSE — bot stays paper-only with no signing path
# active. Flip to true ONLY after generating the keypair (scripts/
# generate_copy_keypair.py) and funding the wallet with USDC + SOL.
COPY_LIVE_ENABLED=false
# Bot-specific Solana keypair (base58-encoded 64-byte secret). NEVER
# commit a real value. Generate with:
#   python -m scripts.generate_copy_keypair --confirm
# Then paste the base58 secret here and the PUBLIC address into
# memory/project_wallet_inventory.md.
COPY_SOLANA_PRIVATE_KEY=
# Live (full-size) execution. Even with COPY_LIVE_ENABLED=true, this
# must ALSO be true to place full-notional swaps. The intermediate
# state (live_enabled=true, live_full_enabled=false) runs SHADOW only —
# small sampled swaps paired to paper trades for calibration_records.
COPY_LIVE_FULL_ENABLED=false
# Open-shadow exposure cap in USD. $40 of the ~$50-100 bot bankroll
# leaves headroom for gas + rent.
COPY_SHADOW_OPEN_CAP_USD=40.0
# Per-shadow notional band (USD).
COPY_SHADOW_NOTIONAL_MIN_USD=10.0
COPY_SHADOW_NOTIONAL_MAX_USD=25.0
# Swap slippage tolerance (bps). 1500 = 15% — memecoin reality. Tune
# down once we see real fills.
COPY_SWAP_SLIPPAGE_BPS=1500
# Compute-unit price (priority fee) in micro-lamports.
COPY_SWAP_PRIORITY_FEE_MICRO_LAMPORTS=50000
# Transaction confirmation timeout (seconds).
COPY_SWAP_CONFIRM_TIMEOUT_SEC=45
