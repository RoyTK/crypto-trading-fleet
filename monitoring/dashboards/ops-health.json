  {
   "id": 3,
   "type": "timeseries",
   "title": "Wallet swaps delivered per hour (webhooks)",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "fleet-postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('hour', event_at) AS time, source_webhook AS metric, count(*) AS value FROM wallet_swaps_log WHERE $__timeFilter(event_at) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     },
     "noValue": "No trades in the selected time range (check the time picker, top right)"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 8,
    "y": 2,
    "w": 16,
    "h": 7
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "No-fill rate per day by strategy (%)",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "fleet-postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('day', created_at) AS time, sim_metadata->>'strategy' AS metric, ROUND(100.0 * count(*) FILTER (WHERE fill_status = 'no_fill') / count(*), 1) AS value FROM trades WHERE bot_id='copy' AND mode='paper' AND $__timeFilter(created_at) AND sim_metadata->>'strategy' IN ('cluster','conviction','swing','teamfollow','cohortfire','promobuy') GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     },
     "noValue": "No trades in the selected time range (check the time picker, top right)"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Slippage by strategy (time range)",
   "datasource": {
    "type": "postgres",
