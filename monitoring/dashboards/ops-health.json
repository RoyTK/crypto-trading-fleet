  {
   "id": 7,
   "type": "stat",
   "title": "Helius — deliveries yesterday",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT COALESCE(sum(calls),0) FROM service_usage_daily WHERE service='helius' AND day = (now()::date - 1)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    }
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Helius — projected credits / mo",
   "gridPos": {
    "x": 6,
    "y": 26,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT COALESCE(round(avg(d)*30),0) FROM (SELECT day, sum(calls) d FROM service_usage_daily WHERE service='helius' AND day >= (now()::date - 7) AND day < now()::date GROUP BY day) x"
    }
   ],
