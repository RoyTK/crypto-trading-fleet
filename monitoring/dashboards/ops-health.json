   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "fleet-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT sim_metadata->>'strategy' AS strategy, count(*) AS n,\n  ROUND(percentile_cont(0.5) WITHIN GROUP (ORDER BY (sim_metadata->>'slippage_bps')::float)::numeric, 0) AS entry_med_bps,\n  ROUND(percentile_cont(0.9) WITHIN GROUP (ORDER BY (sim_metadata->>'slippage_bps')::float)::numeric, 0) AS entry_p90_bps,\n  ROUND(percentile_cont(0.5) WITHIN GROUP (ORDER BY (sim_metadata->>'exit_slippage_bps')::float)::numeric, 0) AS exit_med_bps\nFROM trades WHERE bot_id='copy' AND mode='paper' AND sim_metadata->>'slippage_bps' IS NOT NULL\n  AND sim_metadata->>'strategy' IN ('cluster','conviction','swing','teamfollow','cohortfire','promobuy') AND $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
