  {
   "id": 3,
   "type": "timeseries",
   "title": "Daily wallet pool transitions",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "fleet-postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('day', created_at) AS time, COALESCE(jsonb_array_length((payload->>'promoted')::jsonb), 0) AS promoted, COALESCE(jsonb_array_length((payload->>'demoted')::jsonb), 0) AS demoted, COALESCE(jsonb_array_length((payload->>'dropped')::jsonb), 0) AS dropped, COALESCE(jsonb_array_length((payload->>'swapped')::jsonb), 0) AS swapped FROM audit_log WHERE event_type = 'wallet_pool_daily_transitions' AND $__timeFilter(created_at) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   }
