  {
   "id": 6,
   "type": "table",
   "title": "Watch-tier promotion candidates",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "fleet-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "WITH ev AS (SELECT wallet_address, COUNT(*) FILTER (WHERE event_at >= now() - interval '7 days') AS n7d,\n  COUNT(*) AS n30d FROM wallet_events_log WHERE event_at >= now() - interval '30 days' GROUP BY 1)\nSELECT wp.address AS wallet, COALESCE(ws.cls, '?') AS style, COALESCE(e.n7d, 0) AS events_7d, COALESCE(e.n30d, 0) AS events_30d,\n  wp.last_event_at, wp.source\nFROM wallet_pool wp LEFT JOIN ev e ON e.wallet_address = wp.address LEFT JOIN wallet_style ws ON ws.address = wp.address\nWHERE wp.tier = 'watch' ORDER BY COALESCE(e.n7d, 0) DESC, COALESCE(e.n30d, 0) DESC LIMIT 25"
    }
   ],
