  {
   "id": 13,
   "type": "barchart",
   "title": "Entry liquidity distribution (validates $50k floor)",
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "WITH liq AS (SELECT (sim_metadata->>'entry_liquidity_usd')::float AS l FROM trades WHERE bot_id='copy' AND sim_metadata->>'strategy'='promobuy' AND sim_metadata->>'entry_liquidity_usd' IS NOT NULL) SELECT CASE WHEN l < 50000 THEN '<50k' WHEN l < 100000 THEN '50-100k' WHEN l < 250000 THEN '100-250k' WHEN l < 1000000 THEN '250k-1M' ELSE '1M+' END AS bucket, MIN(l) AS sort_key, COUNT(*) AS count FROM liq GROUP BY 1 ORDER BY sort_key"
    }
   ]
  },
  {
   "id": 20,
   "type": "table",
   "title": "Open paper trades",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT id, asset, CASE WHEN sim_metadata->>'entry_liquidity_usd' IS NULL THEN 'null-liq (small)' ELSE 'has-liq (full)' END AS track, entry_price, size_usd, ROUND((sim_metadata->>'peak_pct_since_entry')::numeric, 1) AS peak_pct, ROUND((sim_metadata->>'entry_liquidity_usd')::numeric, 0) AS entry_liq, entry_at FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='open' AND sim_metadata->>'strategy'='promobuy' ORDER BY entry_at DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
