      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open ${__value.raw} on Birdeye",
          "targetBlank": true,
          "url": "https://birdeye.so/solana/token/${__value.raw}?tab=trades&trades_layout=table"
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "id": 22,
   "type": "table",
   "title": "Promo-Buy halts (14d)",
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT halted_at, halt_type, severity, LEFT(reason, 100) AS reason, resumed_at, resumed_by FROM halts WHERE bot_id='copy_promobuy' AND halted_at >= NOW() - INTERVAL '14 days' ORDER BY halted_at DESC"
    }
   ]
  },
  {
   "id": 30,
   "type": "stat",
   "title": "Promo sources (traded)",
   "gridPos": {
    "x": 4,
    "y": 3,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
