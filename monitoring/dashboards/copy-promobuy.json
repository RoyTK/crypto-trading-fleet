      ]
     }
    ]
   }
  },
  {
   "id": 21,
   "type": "table",
   "title": "Closed paper trades (last 50)",
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT id, asset, CASE WHEN sim_metadata->>'entry_liquidity_usd' IS NULL THEN 'null-liq (small)' ELSE 'has-liq (full)' END AS track, entry_price, exit_price, size_usd, ROUND((sim_metadata->>'peak_pct_since_entry')::numeric, 1) AS peak_pct, ROUND(pnl_pct::numeric, 2) AS pnl_pct, ROUND(pnl_usd::numeric, 2) AS pnl_usd, exit_reason, ROUND((sim_metadata->>'entry_liquidity_usd')::numeric, 0) AS entry_liq, entry_at, exit_at FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND sim_metadata->>'strategy'='promobuy' ORDER BY exit_at DESC NULLS LAST LIMIT 50"
    }
   ],
   "fieldConfig": {
    "defaults": {},
