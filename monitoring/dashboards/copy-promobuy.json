  {
   "id": 1,
   "type": "stat",
   "title": "State",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM halts WHERE bot_id='copy_promobuy' AND resumed_at IS NULL) THEN 'HALTED' ELSE 'running' END AS state"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "running": {
         "text": "running",
         "color": "green"
        }
       }
      },
      {
       "type": "value",
       "options": {
        "HALTED": {
         "text": "HALTED",
         "color": "red"
        }
       }
      }
     ]
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^state$/"
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Open positions",
   "gridPos": {
