   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT COUNT(*) FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND sim_metadata->>'strategy'='promobuy'"
