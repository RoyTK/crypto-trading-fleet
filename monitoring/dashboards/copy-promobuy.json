  {
   "id": 4,
   "type": "stat",
   "title": "Net PnL (closed, USD)",
   "gridPos": {
    "x": 13,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT COALESCE(ROUND(SUM(pnl_usd)::numeric, 2), 0) FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND sim_metadata->>'strategy'='promobuy'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Win rate (closed)",
   "gridPos": {
    "x": 17,
    "y": 3,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT ROUND((COUNT(*) FILTER (WHERE pnl_usd > 0)::float / NULLIF(COUNT(*),0) * 100)::numeric, 1) FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND sim_metadata->>'strategy'='promobuy'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Halts 24h",
   "gridPos": {
    "x": 20,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT COUNT(*) FROM halts WHERE bot_id='copy_promobuy' AND halted_at >= NOW() - INTERVAL '24 hours'"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Cumulative paper PnL (USD)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawSql": "SELECT exit_at AS time, SUM(pnl_usd) OVER (ORDER BY exit_at) AS pnl_cum FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND exit_at IS NOT NULL AND sim_metadata->>'strategy'='promobuy' ORDER BY exit_at"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "PnL per trade (%)",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawSql": "SELECT exit_at AS time, pnl_pct AS value FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND exit_at IS NOT NULL AND sim_metadata->>'strategy'='promobuy' ORDER BY exit_at"
    }
   ]
  },
  {
   "id": 12,
   "type": "barchart",
   "title": "Net PnL by promo source (closed)",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "postgres",
    "uid": "fleet-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT sim_metadata->>'source' AS source, ROUND(SUM(pnl_usd)::numeric, 2) AS net_pnl, COUNT(*) AS n FROM trades WHERE bot_id='copy' AND mode='paper' AND fill_status='closed' AND sim_metadata->>'strategy'='promobuy' AND sim_metadata->>'source' IS NOT NULL GROUP BY 1 ORDER BY net_pnl DESC"
    }
   ],
   "options": {
    "showValue": "always",
    "stacking": "none",
    "orientation": "vertical",
    "groupWidth": 0.7,
    "barWidth": 0.9,
    "legend": {
     "showLegend": true,
     "placement": "bottom",
     "displayMode": "list"
    },
    "xTickLabelRotation": -45
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "net_pnl"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
